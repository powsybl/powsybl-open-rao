# query: contingencyOverriding
PREFIX nc: <https://cim4.eu/ns/nc#>
PREFIX cim: <https://cim.ucaiug.io/ns#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT *
{
GRAPH <%s> {
    ?fullModel
        dcat:startDate ?startDate ;
        dcat:endDate ?endDate ;
        dcat:keyword ?keyword .
    {
    # SSI profile: Contingency and mustStudy are in the cim namespace
    ?contingency
        rdf:type cim:Contingency ;
        cim:Contingency.mustStudy ?mustStudy ;
    } UNION {
    # Legacy: nc namespace
    ?contingency
        rdf:type nc:Contingency ;
        nc:Contingency.mustStudy ?mustStudy ;
    }
}
}

