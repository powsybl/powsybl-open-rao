SELECT *
{
    GRAPH <%s> {
        ?availabilityTimePoint
            rdf:type nc:AvailabilityTimePoint ;
            nc:AvailabilityTimePoint.GenericAvailableSchedule ?genericAvailableSchedule ;
            nc:AvailabilityTimePoint.atTime ?atTime .
        OPTIONAL {
            ?availabilityTimePoint nc:AvailabilityTimePoint.available ?available .
        }
    }
}

