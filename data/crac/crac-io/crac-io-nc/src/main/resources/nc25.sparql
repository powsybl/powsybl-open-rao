# query: remedialActionScheme
PREFIX nc: <https://cim4.eu/ns/nc#>
PREFIX cim: <https://cim.ucaiug.io/ns#>
SELECT *
{
    GRAPH <%s> {
            ?remedialActionScheme
                rdf:type nc:RemedialActionScheme ;
                cim:IdentifiedObject.mRID ?mRID ;
                nc:RemedialActionScheme.kind ?kind ;
                nc:RemedialActionScheme.normalArmed ?normalArmed ;
                { nc:RemedialActionScheme.ArmedRemedialAction ?schemeRemedialAction } UNION { nc:RemedialActionScheme.SchemeRemedialAction ?schemeRemedialAction } .
    }
}

