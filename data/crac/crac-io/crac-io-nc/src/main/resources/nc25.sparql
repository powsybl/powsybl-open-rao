# NCP 2.5 read contract. Generated from nc.sparql (the NCP 2.4 read contract, which stays
# byte-identical) with the NCP 2.5 vocabulary namespaces:
#   nc  = https://cim4.eu/ns/nc#   (was http://entsoe.eu/ns/nc#)
#   cim = https://cim.ucaiug.io/ns# (was http://iec.ch/TC57/CIM100#)
# The CGMES EQ limit vocabularies (cim16 / entsoe SchemaExtension) are kept as in the NCP 2.4
# set, to be confirmed on real production NCP 2.5 packages (see issue #2057, open question 2).
# In the remedialActionScheme query, RemedialActionScheme.ArmedRemedialAction was renamed
# SchemeRemedialAction in RA 2.5.0, so both property names are accepted.
#

# query: contingencyEquipment
PREFIX cim: <https://cim.ucaiug.io/ns#>
SELECT *
{
GRAPH <%s> {
    ?contingencyEquipment
        rdf:type cim:ContingencyEquipment ;
        cim:ContingencyEquipment.Equipment ?contingencyEquipmentId ;
        cim:ContingencyElement.Contingency ?contingency ;
        cim:ContingencyEquipment.contingentStatus ?contingentStatus ;
}
}

# query: header
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT *
{
GRAPH <%s> {
    ?fullModel
        dcat:keyword ?keyword ;
    OPTIONAL {
        ?fullModel
            dcat:startDate ?startDate ;
            dcat:endDate ?endDate ;
        }
}
}

# query: ordinaryContingency
# NCP 2.5: normalMustStudy is RDFS M:1..1 but unconstrained by SHACL and absent in the
# official ReliCapGrid NCP 2.5 test data (tag cgmes-3.0_ncp-2.5_tc-2.0). Absent means the
# contingency is studied (a contingency listed in a CO profile is to be assessed). To be
# confirmed with the NCP working group.
PREFIX cim: <https://cim.ucaiug.io/ns#>
PREFIX nc: <https://cim4.eu/ns/nc#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT *
{
GRAPH <%s> {
    ?contingency
        rdf:type nc:OrdinaryContingency .
    OPTIONAL {
            ?contingency nc:Contingency.normalMustStudy ?mustStudy .
    }
    BIND(COALESCE(?mustStudy, true) AS ?normalMustStudy)
    OPTIONAL {
            ?contingency cim:IdentifiedObject.name ?name .
    }
    OPTIONAL {
            ?contingency nc:Contingency.EquipmentOperator ?idEquipmentOperator .
    }
}
}

