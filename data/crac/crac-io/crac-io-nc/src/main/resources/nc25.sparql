        ?fullModel
            dcat:startDate ?startDate ;
            dcat:endDate ?endDate ;
            dcat:keyword ?keyword .
        ?remedialActionGroup
            rdf:type nc:RemedialActionGroup .
        OPTIONAL {
            ?remedialActionGroup nc:RemedialActionGroup.maxRegulatingUp ?remedialActionGroupMaxRegulatingUp .
        }
        OPTIONAL {
            ?remedialActionGroup nc:RemedialActionGroup.maxRegulatingDown ?remedialActionGroupMaxRegulatingDown .
        }
    }
}

# query: genericAvailableSchedule
PREFIX nc: <https://cim4.eu/ns/nc#>
SELECT *
{
    GRAPH <%s> {
        ?genericAvailableSchedule
            rdf:type nc:GenericAvailableSchedule ;
            nc:BaseTimeSeries.interpolationKind ?interpolationKind ;
            nc:GenericAvailableSchedule.RemedialAction ?remedialAction .
    }
}

# query: availabilityTimePoint
